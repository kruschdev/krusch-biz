# Database Configuration (PostgreSQL + pgvector)
POSTGRES_DB=kruschbiz_db
POSTGRES_USER=kruschbiz
POSTGRES_PASSWORD=kruschbiz_secret
DATABASE_BIND_IP=127.0.0.1
DATABASE_PORT=5436
DATABASE_URL=postgresql://kruschbiz:kruschbiz_secret@127.0.0.1:5436/kruschbiz_db

# Local Ollama Endpoints & Models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-large
OLLAMA_LLM_MODEL=qwen2.5:14b
EMBEDDING_DIM=1024

# Service Ports & Loopback Binding
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=8086
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=8506
BACKEND_URL=http://localhost:8086

# Timeouts & Limits
EMBED_TIMEOUT=30.0
LLM_TIMEOUT=120.0
DEFAULT_RETRIEVAL_LIMIT=5
EMBED_BATCH_SIZE=16

# Security & Ingestion Boundaries
API_KEY=
CORS_ORIGINS=http://localhost:8506,http://127.0.0.1:8506,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_INGEST_DIRS=/app/data,/app/data/ingest,/app/data/fixtures

# KruschNexus Citation Engine Path
KRUSCH_NEXUS_DIR=/home/krusch/homelab/projects/krusch-nexus
KRUSCH_NEXUS_PATH=/home/krusch/homelab/projects/krusch-nexus/src
